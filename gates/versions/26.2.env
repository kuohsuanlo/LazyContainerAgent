# ── Paper 26.2 / Java 25 ──
# 每一行都是「沒設才用這個預設」——換一台機器時 export 同名變數即可覆蓋,不必改檔。
# 這些預設值指向本專案開發機的路徑,別台機器一定要覆蓋前四項與 LC_VIA_DIR。
: "${LC_JAVA_HOME:=/home/logocat/.jdks/jdk-25.0.3+9}"
: "${LC_JAVA_MAJOR:=25}"                       # 目標版 version.json 的 java_version
: "${LC_CLASSFILE_MAJOR:=69}"                  # template 必須編出的 classfile major(Java 25 = 69)
: "${LC_NMS_JAR:="$LC_REPO/nms-lib/paper-26.2-mojmap.jar"}"
: "${LC_PAPER_BUNDLER:=/home/logocat/Server/claude-sandbox/workspace/sv-papertest/server.jar}"
: "${LC_SHAPE_BASELINE:="$LC_REPO/gates/shape/26.2.txt"}"
: "${LC_SPLICE_FIELDS:=7}"                     # build 應印出的 splice 數字(改 template 就會變,變了要一起改這裡)
: "${LC_SPLICE_METHODS:=21}"
: "${LC_BOT_PROTOCOL:=26.1}"                   # minecraft-protocol 宣稱的版本(rig 靠 ViaVersion 翻譯)
: "${LC_VIA_DIR:=/home/logocat/Server/claude-sandbox/workspace/_test-sturdytether-frog/plugins}"
# 真實素材:<分流>:<維度>:<region>。取的是艦隊上真的存在的大倉庫。
: "${LC_FIXTURES:="s3:overworld:r.1.0 s45:the_end:r.-5.-6 s18:the_end:r.-3.-6"}"
: "${LC_FLEET_HOST:=192.168.88.106}"
: "${LC_FLEET_WORLD_TMPL:='/home/logocat/Server/Bungee-%SHARD%/world_%SHARD%/dimensions/minecraft/%DIM%/region/%REG%.mca'}"
: "${LC_CHUNKGUARD_JAR:=/home/logocat/Server/claude-sandbox/workspace/ChunkGuardAgent/target/ChunkGuardAgent.jar}"   # 選配:另一支寫入屏障 agent,一起掛可驗證兩者共存
