# 出貨 gate 測試伺服器:最小、離線、平坦、不生成聚落。
allow-flight=true
difficulty=easy
enable-command-block=true
enforce-secure-profile=false
force-gamemode=false
gamemode=creative
generate-structures=false
level-name=world
level-type=minecraft\:flat
max-players=20
max-tick-time=60000
motd=lazycontainer-gate-rig
online-mode=false
pause-when-empty-seconds=-1
server-port=%PORT%
simulation-distance=6
spawn-monsters=false
spawn-protection=0
sync-chunk-writes=true
view-distance=6
white-list=false
