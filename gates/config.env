# 出貨 gate 的共用設定。每個 MC 版本的差異放 gates/versions/<版本>.env。
# 任何一項都可以用同名環境變數覆蓋(export LC_XXX=... 之後再跑 run.sh)。
: "${LC_MC_VERSION:=26.2}"
LC_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
: "${LC_GATE_HOME:=$HOME/_lcgate}"   # 重產物落腳處(不進 git、不放 scratchpad)
: "${LC_RIG:=$LC_GATE_HOME/rig}"                                            # 測試伺服器
: "${LC_FIXTURES_DIR:=$LC_GATE_HOME/fixtures}"                              # 真實 region 素材(用完刪)
: "${LC_TMUX:=lcgate}"
: "${LC_RIG_PORT:=25599}"
: "${LC_RIG_XMX:=12G}"
: "${LC_KEEP_FIXTURES:=0}"                                                  # 1 = 跑完不刪素材(連跑多輪時用)

# 版本相關設定
# shellcheck source=/dev/null
. "$LC_REPO/gates/versions/$LC_MC_VERSION.env"

: "${JAVA_HOME:=$LC_JAVA_HOME}"
export JAVA_HOME
export PATH="$JAVA_HOME/bin:$PATH"
